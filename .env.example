# Environment Configuration Template
# Copia este archivo a .env y completa con tus valores reales

# Node environment (development, production)
NODE_ENV=development

# App Configuration
VITE_APP_NAME=Chactivo
VITE_APP_URL=https://chactivo.app

# Firebase Configuration
# Completa con tus credenciales de Firebase
VITE_FIREBASE_API_KEY=

VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Opcional: Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Supabase migration flag (mantener false hasta cutover)
VITE_ENABLE_SUPABASE=false
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu_anon_key

# Opcional: Firebase Emulator
VITE_USE_FIREBASE_EMULATOR=false

# Opcional: Firestore transporte robusto (recomendado true si hay latencia alta inicial)
# true  = fuerza long polling (más estable en redes problemáticas)
# false = auto-detect long polling
VITE_FIRESTORE_FORCE_LONG_POLLING=true

# IA transparente (futura; nunca pongas claves privadas VITE_* en el frontend)
# Si se implementa un asistente, la llamada debe vivir en un backend seguro.

# Vite template configuration (opcional - solo para deployment)
# TEMPLATE_BANNER_SCRIPT_URL=
# TEMPLATE_REDIRECT_URL=

# Nota: Todas las variables de entorno que necesitan estar expuestas al cliente
# en Vite deben tener el prefijo VITE_
